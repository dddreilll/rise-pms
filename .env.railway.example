# Copy values into the Railway app service Variables tab (Raw Editor).
# Reference MySQL service variables with Railway template syntax.
#
# Volumes (dashboard): mount persistent storage at
#   /var/www/html/files
#   /var/www/html/writable
#
# Schema (one-time, from your machine after MySQL is up):
#   php scripts/prepare_schema.php rise_ admin@example.com 'YourPassword' 'First' 'Last' > install/database.prefixed.sql
#   Then import database.prefixed.sql into Railway MySQL (CLI or GUI).
# Do not rely on the browser installer — config writes are ephemeral on Railway.

CI_ENVIRONMENT=production

# Optional override; Railway also injects RAILWAY_PUBLIC_DOMAIN which App.php uses for baseURL.
# APP_BASE_URL=https://your-app.up.railway.app
FORCE_HTTPS=true
PROXY_IPS=*

# Keep stable across deploys (do not rely on the browser installer rewriting App.php):
# ENCRYPTION_KEY=your-stable-secret

# Railway MySQL (private networking — do not expose MySQL publicly)
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQLUSER=${{MySQL.MYSQLUSER}}
MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}

# Optional override (defaults to rise_ in app/Config/Database.php)
# DB_PREFIX=rise_
